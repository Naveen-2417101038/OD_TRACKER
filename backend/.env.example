# ── OD Tracking System – Backend Environment Variables ────────────────────────
#
# Copy this file to backend/.env.example to document required server-side vars.
# Never commit actual secrets to git.

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Full connection string from Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=od_tracking

# ── Flask Secret Key ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<your-secret-key-here>

# ── Flask Environment ──────────────────────────────────────────────────────────
# Set to "production" on server. Do NOT set to development in production.
FLASK_ENV=production

# ── Port ───────────────────────────────────────────────────────────────────────
# Most PaaS platforms inject PORT automatically. Set manually if self-hosting.
PORT=5000

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://od-tracker.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=https://your-frontend-domain.com
