# ── OD Tracking System – Frontend Environment Variables ────────────────────────
#
# Copy this file to frontend/.env.local for local development or set in your deployment platform (Vercel / Netlify / Render / Cloudflare Pages).

# API Base URL
# Leave blank in dev to use Vite proxy (forwarding /api requests to http://localhost:5000)
# In production, set to your live backend server URL (e.g., https://your-backend-api.onrender.com)
VITE_API_BASE_URL=http://localhost:5000
