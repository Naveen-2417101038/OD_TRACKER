# ── OD Tracking System – Environment Variables Configuration ─────────────────
#
# Copy this file to .env for local development.
# NEVER commit your actual .env file or real production credentials to Git.

# ── Backend Configuration ─────────────────────────────────────────────────────
# Database Connection (MongoDB Atlas or local instance)
MONGO_URI=mongodb://127.0.0.1:27017/od_tracking
MONGO_DB_NAME=od_tracking

# Flask Security Secret Key
# Generate a secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Flask Server Settings
FLASK_ENV=development
PORT=5000

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend Configuration ────────────────────────────────────────────────────
# API Base URL (leave blank in dev to use Vite proxy -> http://localhost:5000)
# In production, set to your backend server URL (e.g., https://api.yourdomain.com)
VITE_API_BASE_URL=

# ── Email / SMTP Configuration ────────────────────────────────────────────────
# For Gmail, set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_college_or_service_email@rajalakshmi.edu.in
SMTP_PASSWORD=your_smtp_app_password_here
MAIL_DEFAULT_SENDER=noreply@rajalakshmi.edu.in
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:5173

