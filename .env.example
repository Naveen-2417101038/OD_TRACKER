# ── OD Tracking System – Environment Variables Configuration ─────────────────
#
# Copy this file to .env for local development.
# NEVER commit your actual .env file or real production credentials to Git.
#

# ══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT MODE
# ══════════════════════════════════════════════════════════════════════════════
# Set to 'development' locally, 'production' on Azure App Service
FLASK_ENV=development
PORT=5000

# ══════════════════════════════════════════════════════════════════════════════
# OPTION 1: LOCAL DEVELOPMENT (Microsoft SQL Server)
# ══════════════════════════════════════════════════════════════════════════════
# Specify your local SQL Server instance name (e.g. localhost\MSSQLSERVER01 or COMPUTERNAME\INSTANCE)
SQL_SERVER=localhost\MSSQLSERVER02
SQL_DATABASE=ODTRACKINGDB
SQL_DRIVER=ODBC Driver 18 for SQL Server
# Set to 'yes' to use Windows Integrated Authentication (no username/password needed)
SQL_TRUSTED_CONNECTION=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_ENCRYPT=no

# If using local SQL Authentication instead of Windows Auth, set:
# SQL_USER=sa
# SQL_PASSWORD=your_local_password
# SQL_TRUSTED_CONNECTION=no

# ══════════════════════════════════════════════════════════════════════════════
# OPTION 2: PRODUCTION / AZURE APP SERVICE (Azure SQL Database)
# Configure these in Azure Portal -> App Service -> Configuration -> Application settings
# (DO NOT set these in git-tracked files)
# ══════════════════════════════════════════════════════════════════════════════
# AZURE_SQL_SERVER=your-azure-sql-server.database.windows.net
# AZURE_SQL_DATABASE=ODTRACKINGDB
# SQL_DRIVER=ODBC Driver 18 for SQL Server
# SQL_ENCRYPT=yes
# SQL_TRUST_SERVER_CERTIFICATE=no
# SQL_TIMEOUT=30

# Sub-option 2A: System-Assigned Managed Identity (RECOMMENDED - No password needed)
# AZURE_SQL_AUTH_TYPE=managed_identity
# (For User-Assigned Managed Identity, also set the Client ID):
# AZURE_SQL_CLIENT_ID=<user-assigned-identity-client-id>

# Sub-option 2B: Azure SQL Authentication (Fallback)
# AZURE_SQL_AUTH_TYPE=sql
# AZURE_SQL_USER=your_azure_sql_admin_username
# AZURE_SQL_PASSWORD=your_azure_sql_admin_password

# Sub-option 2C: Full connection string override
# AZURE_SQL_CONNECTIONSTRING=mssql+pyodbc:///?odbc_connect=...

# ══════════════════════════════════════════════════════════════════════════════
# SECURITY & CORS
# ══════════════════════════════════════════════════════════════════════════════
# Generate a random 32-byte hex key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API URL (leave blank in local dev to use Vite proxy -> http://localhost:5000)
# In production, set to your backend server URL (e.g., https://api.yourdomain.com)
VITE_API_BASE_URL=

# ══════════════════════════════════════════════════════════════════════════════
# EMAIL NOTIFICATIONS (Resend REST API / SMTP)
# ══════════════════════════════════════════════════════════════════════════════
# Resend REST API (https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME="OD Tracking Application"
APP_BASE_URL=http://localhost:5173

# SMTP Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@rajalakshmi.edu.in
SMTP_PASSWORD=your_smtp_app_password
MAIL_DEFAULT_SENDER=noreply@rajalakshmi.edu.in
SMTP_USE_TLS=true

# ══════════════════════════════════════════════════════════════════════════════
# AZURE BLOB STORAGE (Certificates & OD Documents)
# ══════════════════════════════════════════════════════════════════════════════
# If set, uploaded certificates and OD letters are uploaded directly to Azure Blob Storage.
# If omitted or left blank, files automatically fall back to local folder backend/uploads/
# Option A: Connection string (from Azure Portal -> Storage Account -> Access keys)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=...;EndpointSuffix=core.windows.net

# Option B: Managed Identity or Storage Account URL (for Azure App Service)
# AZURE_STORAGE_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net
# AZURE_STORAGE_USE_MANAGED_IDENTITY=true

# Container names (created automatically if they do not exist)
AZURE_STORAGE_CONTAINER_CERTIFICATES=certificates
AZURE_STORAGE_CONTAINER_OD_LETTERS=od-letters

# ══════════════════════════════════════════════════════════════════════════════
# MONGODB CONFIGURATION (Preserved for migration / reference)
# ══════════════════════════════════════════════════════════════════════════════
MONGO_URI=mongodb://127.0.0.1:27017/od_tracking
MONGO_DB_NAME=od_tracking
